{#
| Variable       | Type   | Description                      |
|----------------|--------|-----------------------------------|
| component.text | string | Marquee text editable from dash  |
#}
{% set _text = component.text | default('🌿 عروض طبيعية – الأصالة في كل عبوة!') %}

<section class="s-block lux-marquee" aria-label="{{ _text }}">
  <div class="lux-marquee__track">
    <div class="lux-marquee__group">
      <span class="lux-marquee__item">{{ _text }}</span>
      <span class="lux-marquee__item">{{ _text }}</span>
      <span class="lux-marquee__item">{{ _text }}</span>
      <span class="lux-marquee__item">{{ _text }}</span>
    </div>
    <div class="lux-marquee__group" aria-hidden="true">
      <span class="lux-marquee__item">{{ _text }}</span>
      <span class="lux-marquee__item">{{ _text }}</span>
      <span class="lux-marquee__item">{{ _text }}</span>
      <span class="lux-marquee__item">{{ _text }}</span>
    </div>
  </div>
</section>
