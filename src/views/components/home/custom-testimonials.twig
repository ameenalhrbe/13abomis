<section class="s-block lux-reviews">

  {# ── Section Header ── #}
  <div class="fp5-head">
    <div class="fp5-title-pill">{{ trans('blocks.home.testimonials') }}</div>
    <div class="fp5-title-dot"></div>
  </div>

  {# ── Slider ── #}
  <div class="lux-reviews__slider-wrap">

    <salla-slider id="custom-testimonials-{{ position }}-slider"
      slides-per-view="3"
      breakpoints='{"0":{"slidesPerView":1},"640":{"slidesPerView":2},"1024":{"slidesPerView":3}}'
      type="testimonials"
      class="lux-reviews__slider"
      controls-outer
      auto-play>

      <div slot="items">
        {% for index, item in component.items %}
        <div class="swiper-slide lux-reviews__slide">
          <div class="lux-reviews__card">

            {# Big decorative quote #}
            <span class="lux-reviews__quote" aria-hidden="true">
              <svg width="40" height="32" viewBox="0 0 40 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 20V12C0 5.373 5.373 0 12 0h2v4H12C7.582 4 4 7.582 4 12v1h8v7H0zm22 0V12C22 5.373 27.373 0 34 0h2v4h-2C29.582 4 26 7.582 26 12v1h8v7H22z" fill="currentColor"/>
              </svg>
            </span>

            {# Review text #}
            <p class="lux-reviews__text">{{ item.text }}</p>

            {# Stars #}
            <div class="lux-reviews__stars">
              {% for i in 1..5 %}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="{{ i <= item.stars ? 'currentColor' : 'none' }}" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              {% endfor %}
            </div>

            {# Divider line #}
            <div class="lux-reviews__sep"></div>

            {# Author #}
            <div class="lux-reviews__author">
              <div class="lux-reviews__avatar">
                <img src="{{ 'images/s-empty.png' | asset }}"
                     data-src="{{ item.avatar }}"
                     alt="{{ item.name }}"
                     class="lazy">
              </div>
              <span class="lux-reviews__name">{{ item.name }}</span>
            </div>

          </div>
        </div>
        {% endfor %}
      </div>

    </salla-slider>

  </div>

</section>
