{#
| Variable                  | Type      | Description                                          |
|---------------------------|-----------|------------------------------------------------------|
| component                 | object    | Merchant settings from twilight.json fields          |
| component.title           | string    | Section title                                        |
| component.products        | Product[] | Products chosen by merchant                          |
| position                  | int       | Sorting block index                                  |
#}
{% set component_id = 'fp4-' ~ position %}
{% set _title = component.title %}
{% set _products = component.products %}

{% if _products|length %}
<section class="s-block s-block--perfume-products container" id="{{ component_id }}">

    {% if _title %}
    <div class="perfume-section__header">
        <div class="perfume-section__title-wrapper">
            <h2 class="perfume-section__title">{{ _title }}</h2>
            <span class="perfume-section__title-line"></span>
        </div>
    </div>
    {% endif %}

    <div class="perfume-products-grid">
        {% for product in _products %}

        <div class="perfume-card-wrap">
            <div class="perfume-card__image-area">
                <a href="{{ product.url }}" aria-label="{{ product.name }}">
                    <img
                        src="{{ product.image.url }}"
                        alt="{{ product.image.alt }}"
                        class="perfume-card__image"
                        loading="lazy"
                    />
                </a>
                {% if product.is_on_sale and product.discount_percentage %}
                <span class="perfume-card__badge">{{ product.discount_percentage }}</span>
                {% endif %}
                <salla-button shape="icon" size="sm" class="perfume-card__wishlist"
                    onclick="salla.wishlist.toggle({{ product.id }})"
                    title="{{ 'wishlist.add' | trans }}">
                    <i class="{{ product.is_in_wishlist ? 'sicon-heart-fill' : 'sicon-heart' }}"></i>
                </salla-button>
            </div>

            <div class="perfume-card">
                <a href="{{ product.url }}" class="perfume-card__name">{{ product.name }}</a>

                <div class="perfume-card__price-row">
                    {% if product.is_on_sale %}
                    <span class="perfume-card__price-old">{{ product.regular_price | money }}</span>
                    {% endif %}
                    <span class="perfume-card__price-current">{{ product.price | money }}</span>
                </div>

                <div class="perfume-card__actions">
                    <salla-add-product-button
                        product-id="{{ product.id }}"
                        product-status="{{ product.status }}"
                        product-type="{{ product.type }}"
                        class="perfume-card__add-btn"
                    >
                        <i class="sicon-bag-add"></i>
                        <span>{{ 'cart.add_to_cart' | trans }}</span>
                    </salla-add-product-button>

                    <salla-quantity-input
                        product-id="{{ product.id }}"
                        max="{{ product.max_quantity }}"
                        class="perfume-card__quantity"
                    ></salla-quantity-input>
                </div>

                {% if product.rating and product.rating.count > 0 %}
                <div class="perfume-card__rating">
                    <salla-rating-stars rate="{{ product.rating.stars }}"></salla-rating-stars>
                </div>
                {% endif %}
            </div>
        </div>

        {% endfor %}
    </div>

</section>
{% endif %}
