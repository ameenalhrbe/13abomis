{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}
<header class="store-header lux-header">

  {# ─── Top Bar ─── #}
  <div class="lux-topbar">
    <div class="container lux-topbar__inner">

      <div class="lux-topbar__start">
        {% if important_links %}
          <salla-menu source="footer" topnav></salla-menu>
        {% endif %}

        {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
          <button type="button" onclick="salla.event.dispatch('localization::open')" class="lux-topbar__lang-btn">
            <i class="sicon-globe-outline"></i>
            <span>{{ user.language.name }}</span>
            <span class="lux-topbar__sep">|</span>
            <span>{{ currency.symbol }}</span>
          </button>
          <salla-localization-modal></salla-localization-modal>
        {% endif %}

        {% if store.scope %}
          <button class="lux-topbar__lang-btn" onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
            <i class="sicon-location"></i>
            <span>{{ store.scope.name }}</span>
          </button>
        {% endif %}
      </div>

      <div class="lux-topbar__end">
        <salla-contacts is-header></salla-contacts>
      </div>

    </div>
  </div>

  {# ─── Main Nav ─── #}
  <div id="mainnav" class="lux-mainnav main-nav-container shadow-default bg-with flex items-center">
    <div class="inner bg-inherit w-full">
      <div class="container lux-mainnav__inner">

        {# Logo + Hamburger #}
        <div class="lux-mainnav__brand">
          <a class="lg:hidden lux-burger mburger mburger--collapse" href="#mobile-menu" aria-label="Open menu">
            <span></span><span></span><span></span>
          </a>
          {% set logo_text = theme.settings.get('logo_text') %}
          <a class="navbar-brand lux-logo" href="">
            {% if logo_text %}
              <span class="lux-logo-text" aria-label="{{ store.name }}">{{ logo_text }}</span>
            {% elseif store.logo %}
              <img fetchpriority="high" width="100%" height="100%" loading="eager"
                   src="{{ store.logo }}" alt="{{ store.name }} logo">
            {% else %}
              <span class="lux-logo-text" aria-label="{{ store.name }}">{{ store.name }}</span>
            {% endif %}
            {% if is_page('index') %}
              <h1 class="sr-only">{{ store.name }}</h1>
            {% else %}
              <h2 class="sr-only">{{ store.name }}</h2>
            {% endif %}
          </a>
        </div>

        {# Desktop Menu #}
        <nav class="lux-mainnav__menu">
          <custom-main-menu></custom-main-menu>
        </nav>

        {# Actions: Search · User · Cart #}
        <div class="lux-mainnav__actions">

          {# Inline Search #}
          <div class="lux-search-wrap">
            <salla-search inline oval height="38"></salla-search>
          </div>

          {# Divider #}
          <span class="lux-actions-divider"></span>

          {# User — identical button structure whether logged in or not #}
          {% if user.type == 'user' %}
            <button class="lux-action-btn" aria-label="حسابي" data-lux-user-toggle>
              <svg class="lux-action-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 20c0-3.866 3.582-7 8-7s8 3.134 8 7"/>
              </svg>
              <span class="lux-logged-dot"></span>
            </button>
          {% else %}
            <button class="lux-action-btn" aria-label="تسجيل الدخول" onclick="salla.event.dispatch('login::open')">
              <svg class="lux-action-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 20c0-3.866 3.582-7 8-7s8 3.134 8 7"/>
              </svg>
            </button>
          {% endif %}

          {# Cart #}
          <salla-cart-summary class="lux-action-btn lux-cart-btn">
            <svg slot="icon" class="lux-action-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </salla-cart-summary>

        </div>
      </div>
    </div>
  </div>

  {# User portal — position:fixed via JS, outside flex row to avoid layout impact #}
  {% if user.type == 'user' %}
  <div class="lux-user-portal" id="lux-user-portal" aria-hidden="true">
    <div class="lux-umenu">
      <div class="lux-umenu__head">
        <span class="lux-umenu__avatar">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 20c0-3.866 3.582-7 8-7s8 3.134 8 7"/>
          </svg>
        </span>
        <div class="lux-umenu__info">
          <span class="lux-umenu__name">{{ user.name }}</span>
          {% if user.email %}
            <span class="lux-umenu__email">{{ user.email }}</span>
          {% endif %}
        </div>
      </div>
      <nav class="lux-umenu__nav">
        <a href="/customer/profile" class="lux-umenu__item">
          <i class="sicon-user-circle"></i><span>حسابي</span>
        </a>
        <a href="/customer/orders" class="lux-umenu__item">
          <i class="sicon-list"></i><span>طلباتي</span>
        </a>
        <a href="/wishlist" class="lux-umenu__item">
          <i class="sicon-heart"></i><span>المفضلة</span>
        </a>
        <a href="/customer/addresses" class="lux-umenu__item">
          <i class="sicon-location"></i><span>عناويني</span>
        </a>
        <button class="lux-umenu__item lux-umenu__item--logout" onclick="salla.auth.logout()">
          <i class="sicon-logout"></i><span>تسجيل الخروج</span>
        </button>
      </nav>
    </div>
  </div>
  {% endif %}

</header>
