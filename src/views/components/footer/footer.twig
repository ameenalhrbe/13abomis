<footer class="store-footer lux-footer">

  {# ─── Decorative Divider ─── #}
  <div class="lux-footer__divider" aria-hidden="true">
    <div class="lux-footer__divider-line"></div>
    <span class="lux-footer__divider-gem">✦</span>
    <div class="lux-footer__divider-line"></div>
  </div>

  {# ─── Main Body ─── #}
  <div class="lux-footer__body" aria-label="footer">
    <div class="container lux-footer__grid">

      {# ── Column 1: Brand ── #}
      <div class="lux-footer__brand">
        <a href="{{ link('/') }}" class="lux-footer__logo-link">
          <img src="{{ store.logo }}" alt="{{ store.name }}" class="lux-footer__logo" loading="lazy">
          <span class="sr-only">{{ store.name }}</span>
        </a>

        {% if store.description %}
          <p class="lux-footer__desc">{{ store.description | striptags | slice(0, 160) }}</p>
        {% endif %}

        <salla-social class="lux-footer__social"></salla-social>

        {# Trust Badges #}
        <div class="lux-footer__badges">
          <salla-trust-badges dark></salla-trust-badges>
        </div>
      </div>

      {# ── Column 2: Quick Links ── #}
      <div class="lux-footer__col">
        <h4 class="lux-footer__heading">{{ trans('blocks.footer.pages_links') }}</h4>
        <div class="lux-footer__heading-line"></div>
        <salla-menu source="footer"></salla-menu>
      </div>

      {# ── Column 3: Contact ── #}
      <div class="lux-footer__col">
        <h4 class="lux-footer__heading">{{ trans('blocks.footer.contact_us') | default('تواصل معنا') }}</h4>
        <div class="lux-footer__heading-line"></div>
        <salla-contacts></salla-contacts>

        {# VAT Number #}
        {% if store.settings.tax.number %}
          <div class="lux-footer__vat">
            {% if store.settings.tax.certificate %}
              <a class="load-img-onclick lux-footer__vat-logo" data-modal-id="modal-value-tax" href="#/" alt="{{ store.settings.tax.number }}">
                <img width="36" height="44" src="{{ 'images/s-empty.png' | cdn }}"
                     data-src="{{ 'images/tax.png' | cdn(70,70) }}"
                     class="lazy" alt="ضريبة القيمة المضافة">
              </a>
            {% endif %}
            <div>
              <span class="lux-footer__vat-label">{{ trans('common.elements.tax_number') }}</span>
              <b class="lux-footer__vat-num">{{ store.settings.tax.number }}</b>
            </div>
          </div>

          {% if store.settings.tax.certificate %}
            <salla-modal sub-title-first sub-title="{{ trans('common.elements.tax_number') }}"
                         modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
              <div class="flex justify-center max-w-full">
                <img class="w-full" loading="lazy"
                     src="{{ 'images/s-empty.png' | cdn }}"
                     data-src="{{ store.settings.tax.certificate }}"
                     alt="{{ store.settings.tax.number }}"/>
              </div>
            </salla-modal>
          {% endif %}
        {% endif %}
      </div>

      {# ── Column 4: App + Payments ── #}
      <div class="lux-footer__col">
        <h4 class="lux-footer__heading">{{ trans('blocks.footer.download_app') | default('حمّل التطبيق') }}</h4>
        <div class="lux-footer__heading-line"></div>
        <salla-apps-icons></salla-apps-icons>
      </div>

    </div>
  </div>

  {# ─── Bottom Bar ─── #}
  <div class="lux-footer__bottom">
    <div class="container lux-footer__bottom-inner">
      <span class="lux-footer__copyright">{% hook copyright %}</span>
      <salla-payments class="lux-footer__payments"></salla-payments>
    </div>
  </div>

</footer>

<span class="hidden bottom-2 rtl:pl-24 ltr:pr-24 md:grid-cols-3 opacity-40"></span>
