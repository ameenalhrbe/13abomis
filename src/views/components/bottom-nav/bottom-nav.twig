{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
#}
<nav class="lux-bottomnav" aria-label="التنقل السفلي">
  <div class="lux-bottomnav__inner">

    <a href="{{ link('/') }}" class="lux-bottomnav__item {{ is_page('index') ? 'is-active' : '' }}">
      <span class="lux-bottomnav__icon-wrap">
        <svg class="lux-bottomnav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 11.5 12 4l9 7.5"/>
          <path d="M5 10v10a1 1 0 0 0 1 1h3v-6h6v6h3a1 1 0 0 0 1-1V10"/>
        </svg>
      </span>
      <span class="lux-bottomnav__label">الرئيسية</span>
    </a>

    <a href="#mobile-menu" class="lux-bottomnav__item" aria-label="فتح قائمة الأقسام">
      <span class="lux-bottomnav__icon-wrap">
        <svg class="lux-bottomnav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="1.5"/>
          <rect x="14" y="3" width="7" height="7" rx="1.5"/>
          <rect x="3" y="14" width="7" height="7" rx="1.5"/>
          <rect x="14" y="14" width="7" height="7" rx="1.5"/>
        </svg>
      </span>
      <span class="lux-bottomnav__label">الأقسام</span>
    </a>

    <a href="{{ link('/cart') }}" class="lux-bottomnav__item {{ is_page('cart') ? 'is-active' : '' }}">
      <span class="lux-bottomnav__icon-wrap">
        <svg class="lux-bottomnav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="lux-bottomnav__badge" data-cart-count {{ cart.items_count > 0 ? '' : 'hidden' }}>{{ cart.items_count }}</span>
      </span>
      <span class="lux-bottomnav__label">السلة</span>
    </a>

    <a href="{{ link('/wishlist') }}" class="lux-bottomnav__item {{ is_page('wishlist') ? 'is-active' : '' }}">
      <span class="lux-bottomnav__icon-wrap">
        <svg class="lux-bottomnav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </span>
      <span class="lux-bottomnav__label">المفضلة</span>
    </a>

    {% if user.type == 'user' %}
      <a href="/customer/profile" class="lux-bottomnav__item {{ is_page('customer.profile') ? 'is-active' : '' }}">
        <span class="lux-bottomnav__icon-wrap">
          <svg class="lux-bottomnav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 20c0-3.866 3.582-7 8-7s8 3.134 8 7"/>
          </svg>
        </span>
        <span class="lux-bottomnav__label">حسابي</span>
      </a>
    {% else %}
      <button type="button" class="lux-bottomnav__item" onclick="salla.event.dispatch('login::open')">
        <span class="lux-bottomnav__icon-wrap">
          <svg class="lux-bottomnav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 20c0-3.866 3.582-7 8-7s8 3.134 8 7"/>
          </svg>
        </span>
        <span class="lux-bottomnav__label">حسابي</span>
      </button>
    {% endif %}

  </div>
</nav>
